<Window x:Class="Lab_rab_4_1_Safin_R._R._23_02.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_rab_4_1_Safin_R._R._23_02.View"
        mc:Ignorable="d"
        Title="Сотрудники" Height="350" Width="550">
    <StackPanel>
        <ListView x:Name="lvEmployee" 
                  ItemsSource="{Binding ListPersonDpo}" 
                  SelectedItem="{Binding SelectedPersonDpo}"
                  Margin="5">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="50" 
                                        DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Фамилия" Width="100" 
                                        DisplayMemberBinding="{Binding LastName}"/>
                        <GridViewColumn Header="Имя" Width="100" 
                                        DisplayMemberBinding="{Binding FirstName}"/>
                        <GridViewColumn Header="Должность" Width="120" 
                                        DisplayMemberBinding="{Binding RoleName}"/>
                        <GridViewColumn Header="Дата рождения" Width="120" 
                                        DisplayMemberBinding="{Binding Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="Добавить" Height="25" Width="100" Margin="5"
                    Command="{Binding AddPerson}"/>
            <Button Content="Редактировать" Height="25" Width="100" Margin="5"
                    Command="{Binding EditPerson}"/>
            <Button Content="Удалить" Height="25" Width="100" Margin="5"
                    Command="{Binding DeletePerson}"/>
        </StackPanel>
    </StackPanel>
</Window>